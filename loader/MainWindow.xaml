<Window x:Class="TemporarySpoofer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TemporarySpoofer"
        Title="Temporary Spoofer" Height="680" Width="580"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="Transparent" AllowsTransparency="True"
        WindowStyle="None">

    <Window.Resources>
        <!-- Step row template: stateful icon + name + duration badge. -->
        <DataTemplate x:Key="StepTemplate" DataType="{x:Type local:StepItem}">
            <Border x:Name="card" Margin="0,3" Padding="14,10" CornerRadius="8"
                    Background="#101018" BorderBrush="#1E1E26" BorderThickness="1"
                    Opacity="0" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <TransformGroup>
                        <TranslateTransform Y="8"/>
                        <ScaleTransform ScaleX="0.985" ScaleY="0.985"/>
                    </TransformGroup>
                </Border.RenderTransform>
                <Border.Triggers>
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.28"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).Children[0].(TranslateTransform.Y)" From="8" To="0" Duration="0:0:0.28">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).Children[1].(ScaleTransform.ScaleX)" From="0.985" To="1" Duration="0:0:0.28"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).Children[1].(ScaleTransform.ScaleY)" From="0.985" To="1" Duration="0:0:0.28"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- status icon -->
                    <Grid Grid.Column="0" Width="24" Height="24" HorizontalAlignment="Left">
                        <!-- pending: hollow ring -->
                        <Ellipse Width="14" Height="14" Stroke="#3A3A44" StrokeThickness="2" Visibility="{Binding ShowPending}"/>

                        <!-- running: brand pulse -->
                        <Grid Visibility="{Binding ShowRunning}">
                            <Ellipse x:Name="pulseA" Width="24" Height="24" Fill="{StaticResource Accent}" Opacity="0.2">
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.08" To="0.32" Duration="0:0:0.9" AutoReverse="True" RepeatBehavior="Forever"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                            <Ellipse Width="10" Height="10" Fill="{StaticResource Accent}"/>
                        </Grid>

                        <!-- done: check path pop -->
                        <Grid x:Name="doneGroup" Visibility="{Binding ShowDone}" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
                            <Grid.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.4" To="1" Duration="0:0:0.28">
                                                <DoubleAnimation.EasingFunction><BackEase Amplitude="0.6" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.4" To="1" Duration="0:0:0.28">
                                                <DoubleAnimation.EasingFunction><BackEase Amplitude="0.6" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Grid.Triggers>
                            <Ellipse Width="22" Height="22" Fill="#052E16" Stroke="#16A34A" StrokeThickness="1.5"/>
                            <Path Data="{StaticResource IconCheck}" Stroke="#4ADE80" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="12" Height="12" Stretch="Uniform"/>
                        </Grid>

                        <!-- failed: x path -->
                        <Grid Visibility="{Binding ShowFailed}">
                            <Ellipse Width="22" Height="22" Fill="#2A0A0A" Stroke="#DC2626" StrokeThickness="1.5"/>
                            <Path Data="{StaticResource IconBang}" Stroke="#F87171" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="4" Height="12" Stretch="Uniform"/>
                        </Grid>
                    </Grid>

                    <!-- name + category -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium" Foreground="{StaticResource Text}" Opacity="{Binding NameOpacity}"/>
                        <TextBlock Text="{Binding Category}" FontSize="10" Foreground="#5A5A66" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- duration -->
                    <TextBlock Grid.Column="2" Text="{Binding DurationLabel}" FontSize="10" Foreground="#5A5A66" VerticalAlignment="Center" FontFamily="{StaticResource Mono}" Margin="12,0,0,0"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="Root" Background="{StaticResource Bg}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="12" Opacity="0">
        <Border.RenderTransform><TranslateTransform Y="18"/></Border.RenderTransform>
        <Grid>
            <!-- Layer 1: squared grid pattern (hairline lines, low opacity) -->
            <Border CornerRadius="12" ClipToBounds="True" IsHitTestVisible="False">
                <Rectangle Fill="{StaticResource GridBrush}"/>
            </Border>

            <!-- Layer 2: two drifting brand glows in opposite corners -->
            <Border CornerRadius="12" ClipToBounds="True" IsHitTestVisible="False">
                <Grid>
                    <Ellipse Width="420" Height="420" Fill="{StaticResource GlowBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-120,-140,0,0" Opacity="0.95">
                        <Ellipse.RenderTransform><TranslateTransform x:Name="glowA" X="0" Y="0"/></Ellipse.RenderTransform>
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="glowA" Storyboard.TargetProperty="X" From="-10" To="18" Duration="0:0:9" AutoReverse="True" RepeatBehavior="Forever"/>
                                        <DoubleAnimation Storyboard.TargetName="glowA" Storyboard.TargetProperty="Y" From="-6" To="12" Duration="0:0:11" AutoReverse="True" RepeatBehavior="Forever"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                    <Ellipse Width="380" Height="380" Fill="{StaticResource GlowBrushSoft}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-100,-120" Opacity="0.9">
                        <Ellipse.RenderTransform><TranslateTransform x:Name="glowB" X="0" Y="0"/></Ellipse.RenderTransform>
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="glowB" Storyboard.TargetProperty="X" From="8" To="-14" Duration="0:0:10" AutoReverse="True" RepeatBehavior="Forever"/>
                                        <DoubleAnimation Storyboard.TargetName="glowB" Storyboard.TargetProperty="Y" From="6" To="-10" Duration="0:0:12" AutoReverse="True" RepeatBehavior="Forever"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                </Grid>
            </Border>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Title bar -->
                <Border Grid.Row="0" Background="{StaticResource Panel}" MouseLeftButtonDown="TitleBar_MouseDown" CornerRadius="12,12,0,0">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                            <TextBlock x:Name="BrandLabel" Text="Temporary Spoofer" FontSize="12" FontWeight="SemiBold" Foreground="#C8C8CC" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Welcome!" FontSize="11" Foreground="#9CA3AF" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource ChromeBtn}" Click="SettingsBtn_Click" ToolTip="Settings">
                                <Path Data="{StaticResource IconGear}" Stroke="#AAA" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="#88000000" Width="16" Height="16" Stretch="Uniform"/>
                            </Button>
                            <Button Style="{StaticResource ChromeBtn}" Click="MinBtn_Click">
                                <Path Data="{StaticResource IconMin}" Stroke="#AAA" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="14" Height="14" Stretch="Uniform"/>
                            </Button>
                            <Button Style="{StaticResource CloseBtn}" Click="CloseBtn_Click">
                                <Path Data="{StaticResource IconClose}" Stroke="#AAA" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="Uniform"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Pinned-version banner (collapsed unless user pinned a non-latest build) -->
                <Border x:Name="PinnedBanner" Grid.Row="1" Margin="16,12,16,0" CornerRadius="8"
                        Background="#2A1810" BorderBrush="#F59E0B" BorderThickness="1"
                        Padding="14,10" Visibility="Collapsed">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconBang}" Stroke="#FBBF24" StrokeThickness="2.2" StrokeStartLineCap="Round" Width="4" Height="14" Stretch="Uniform" Margin="2,0,10,0"/>
                            <TextBlock FontSize="12" Foreground="#F8E8CC">
                                <Run>Pinned to</Run>
                                <Run x:Name="PinnedBannerVersion" FontWeight="Bold" Foreground="#FBBF24"/>
                                <Run>— you're not on the latest build.</Run>
                            </TextBlock>
                        </StackPanel>
                        <Button HorizontalAlignment="Right" Style="{StaticResource GhostBtn}" Padding="12,4" Click="UnpinBanner_Click">
                            <TextBlock Text="Unpin &amp; restart" Foreground="#F8E8CC" FontSize="11" FontWeight="SemiBold"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Metrics row -->
                <Grid Grid.Row="2" Margin="16,16,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="8" Padding="14,11" Margin="0,0,4,0" x:Name="m1">
                        <StackPanel>
                            <TextBlock Text="STATUS" FontSize="10" Foreground="#666" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock x:Name="StatusText" Text="UNDETECTED" FontSize="14" Foreground="#4ADE80" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="{StaticResource Panel}" CornerRadius="8" Padding="14,11" Margin="4,0,4,0" x:Name="m2">
                        <StackPanel>
                            <TextBlock Text="SUPPORTED ON" FontSize="10" Foreground="#666" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock Text="EAC/BE" FontSize="14" Foreground="#E0E0E4" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="{StaticResource Panel}" CornerRadius="8" Padding="14,11" Margin="4,0,4,0" x:Name="m3">
                        <StackPanel>
                            <TextBlock Text="VERSION" FontSize="10" Foreground="#666" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock Text="VAULT" FontSize="14" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Background="{StaticResource Panel}" CornerRadius="8" Padding="14,11" Margin="4,0,0,0" x:Name="m4">
                        <StackPanel>
                            <TextBlock Text="EXPIRES" FontSize="10" Foreground="#666" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock x:Name="ExpiryText" Text="—" FontSize="14" Foreground="#E0E0E4" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Action buttons -->
                <Grid Grid.Row="3" Margin="16,14,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" x:Name="CleanBtn" Style="{StaticResource FlatBtn}" Padding="0,12" Click="CleanBtn_Click" Margin="0,0,5,0" IsEnabled="False">
                        <TextBlock x:Name="CleanBtnLabel" Text="1. CLEAN TRACES" Foreground="#0A0A0A" FontWeight="SemiBold" FontSize="13"/>
                    </Button>

                    <Button Grid.Column="1" x:Name="SpoofBtn" Style="{StaticResource SolidBtn}" Padding="0,12" Click="SpoofBtn_Click" Margin="5,0,0,0" IsEnabled="False">
                        <TextBlock x:Name="SpoofBtnLabel" Text="2. SPOOF HWID" Foreground="{StaticResource Text}" FontWeight="SemiBold" FontSize="13"/>
                    </Button>
                </Grid>

                <!-- Step list -->
                <Grid Grid.Row="4" Margin="16,14,16,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="Pipeline" FontSize="11" Foreground="#555" FontWeight="SemiBold"/>
                        <TextBlock x:Name="PipelineHint" Text="Ready when you are." FontSize="11" Foreground="#555" HorizontalAlignment="Right"/>
                    </Grid>

                    <ScrollViewer x:Name="StepScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="2,0">
                        <StackPanel>
                            <Border x:Name="IdleHint" Padding="18,22" CornerRadius="10" Background="#101018" BorderBrush="#1E1E26" BorderThickness="1" Margin="0,2">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock x:Name="IdleHeadline" Text="Waiting on your call." FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="#C8C8CC"/>
                                    <TextBlock x:Name="IdleSubline" Text="Pick Spoof or Clean above." FontSize="11" Foreground="#666" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <ItemsControl x:Name="StepList"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- Progress bar with glow pulse while running -->
                <Grid Grid.Row="5" Margin="16,14,16,16">
                    <Border Background="#1A1A22" Height="4" CornerRadius="2"/>
                    <Border x:Name="ProgressBar" Background="{StaticResource Accent}" Height="4" HorizontalAlignment="Left" Width="0" CornerRadius="2"/>
                </Grid>
            </Grid>

            <!-- Settings overlay -->
            <Border x:Name="SettingsOverlay" Background="#F20A0A0E" Opacity="0" IsHitTestVisible="False" CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header strip with subtle brand underline -->
                    <Border Grid.Row="0" Padding="22,18,16,14" BorderThickness="0,0,0,1" BorderBrush="#1A1A24">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconGear}" Stroke="{StaticResource Accent}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0"/>
                                <TextBlock Text="Settings" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Text}" VerticalAlignment="Center"/>
                                <TextBlock Text="customize your spoofer" FontSize="11" Foreground="#5A5A66" VerticalAlignment="Center" Margin="10,2,0,0"/>
                            </StackPanel>
                            <Button Style="{StaticResource CloseBtn}" HorizontalAlignment="Right" Click="SettingsClose_Click" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconClose}" Stroke="#AAA" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="Uniform"/>
                            </Button>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" Margin="18,14,10,10" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                        <StackPanel>

                            <!-- Spoof Components -->
                            <Grid Margin="0,2,0,8">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="3" Height="12" Background="{StaticResource Accent}" CornerRadius="2" Margin="0,0,8,0"/>
                                    <TextBlock Text="SPOOF COMPONENTS" FontSize="10" Foreground="#8A8A95" FontWeight="Bold"/>
                                </StackPanel>
                                <TextBlock Text="pick what the pipeline rotates" FontSize="10" Foreground="#5A5A66" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <Border Background="{StaticResource Panel}" BorderBrush="#1E1E26" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,18">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <CheckBox Grid.Column="0" Grid.Row="0" x:Name="CompNetwork" Content="Network identifiers (MAC)" Margin="0,6"/>
                                    <CheckBox Grid.Column="1" Grid.Row="0" x:Name="CompStorage" Content="Disk serials"              Margin="0,6"/>
                                    <CheckBox Grid.Column="0" Grid.Row="1" x:Name="CompSystem"  Content="SMBIOS / TPM / SID"        Margin="0,6"/>
                                    <CheckBox Grid.Column="1" Grid.Row="1" x:Name="CompCache"   Content="Identifier cache"          Margin="0,6"/>
                                    <CheckBox Grid.Column="0" Grid.Row="2" x:Name="CompAudit"   Content="Pre/post audit"            Margin="0,6"/>
                                    <CheckBox Grid.Column="1" Grid.Row="2" x:Name="CompVerify"  Content="Rotation verify"           Margin="0,6"/>
                                    <CheckBox Grid.Column="0" Grid.Row="3" x:Name="CompBackup"  Content="Registry snapshot"         Margin="0,6"/>
                                </Grid>
                            </Border>

                            <!-- Mode -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Width="3" Height="12" Background="{StaticResource Accent}" CornerRadius="2" Margin="0,0,8,0"/>
                                <TextBlock Text="MODE" FontSize="10" Foreground="#8A8A95" FontWeight="Bold"/>
                            </StackPanel>
                            <Border Background="{StaticResource Panel}" BorderBrush="#1E1E26" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,18">
                                <StackPanel>
                                    <RadioButton x:Name="ModeStealth"  GroupName="Mode" Content="Stealth — low and slow, maximum coverage"   Margin="0,6"/>
                                    <RadioButton x:Name="ModeTurbo"    GroupName="Mode" Content="Turbo — faster, skips verify pass"         Margin="0,6"/>
                                    <RadioButton x:Name="ModeCautious" GroupName="Mode" Content="Cautious — double verify, slower"          Margin="0,6"/>
                                </StackPanel>
                            </Border>

                            <!-- Appearance -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Width="3" Height="12" Background="{StaticResource Accent}" CornerRadius="2" Margin="0,0,8,0"/>
                                <TextBlock Text="APPEARANCE" FontSize="10" Foreground="#8A8A95" FontWeight="Bold"/>
                            </StackPanel>
                            <Border Background="{StaticResource Panel}" BorderBrush="#1E1E26" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,18">
                                <WrapPanel>
                                    <RadioButton x:Name="ThemeDefault"  GroupName="Theme" Content="Default"  Margin="0,6,20,6"/>
                                    <RadioButton x:Name="ThemeMidnight" GroupName="Theme" Content="Midnight" Margin="0,6,20,6"/>
                                    <RadioButton x:Name="ThemeOcean"    GroupName="Theme" Content="Ocean"    Margin="0,6,20,6"/>
                                    <RadioButton x:Name="ThemeAmber"    GroupName="Theme" Content="Amber"    Margin="0,6,0,6"/>
                                </WrapPanel>
                            </Border>

                            <!-- Developer Options -->
                            <Grid Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="3" Height="12" Background="{StaticResource Warn}" CornerRadius="2" Margin="0,0,8,0"/>
                                    <TextBlock Text="DEVELOPER OPTIONS" FontSize="10" Foreground="#8A8A95" FontWeight="Bold"/>
                                </StackPanel>
                                <CheckBox x:Name="DevOptsToggle" Content="Enable" HorizontalAlignment="Right" Checked="DevOpts_Changed" Unchecked="DevOpts_Changed"/>
                            </Grid>
                            <Border x:Name="DevOptsPanel" Background="{StaticResource Panel}" BorderBrush="#1E1E26" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,18" Visibility="Collapsed">
                                <StackPanel>
                                    <Border Background="#2A1810" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                                        <TextBlock Foreground="#F8E8CC" FontSize="12" TextWrapping="Wrap" LineHeight="18">
                                            <Run FontWeight="Bold" Foreground="#FBBF24">Use at your own risk.</Run>
                                            Pinning an older version downloads and launches the archived build exactly as it was. Older builds may lack fixes, miss newer bypasses, or stop working if a provider blocks them. We always recommend the latest release.
                                        </TextBlock>
                                    </Border>

                                    <Grid Margin="0,0,0,10">
                                        <TextBlock Text="VERSION HISTORY" FontSize="10" Foreground="#666" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="PinnedHint" FontSize="10" Foreground="#9CA3AF" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <ItemsControl x:Name="VersionList"/>

                                    <TextBlock x:Name="VersionsLoading" Text="Loading versions..." FontSize="11" Foreground="#666" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- About -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Width="3" Height="12" Background="#555562" CornerRadius="2" Margin="0,0,8,0"/>
                                <TextBlock Text="ABOUT" FontSize="10" Foreground="#8A8A95" FontWeight="Bold"/>
                            </StackPanel>
                            <Border Background="{StaticResource Panel}" BorderBrush="#1E1E26" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,20">
                                <StackPanel>
                                    <TextBlock Text="Temporary Spoofer" FontSize="13" FontWeight="SemiBold" Foreground="#E0E0E4"/>
                                    <TextBlock x:Name="AboutBuild" FontSize="11" Foreground="#666" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Sticky footer with top hairline -->
                    <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="#1A1A24" Background="#0C0C12">
                        <Grid Margin="18,14,18,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource SolidBtn}" Padding="0,12" Margin="0,0,5,0" Click="SettingsClose_Click">
                                <TextBlock Text="Cancel" Foreground="{StaticResource Text}" FontWeight="SemiBold" FontSize="13"/>
                            </Button>
                            <Button Grid.Column="1" Style="{StaticResource FlatBtn}" Padding="0,12" Margin="5,0,0,0" Click="SettingsSave_Click">
                                <TextBlock Text="Save settings" Foreground="#0A0A0A" FontWeight="SemiBold" FontSize="13"/>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Success overlay -->
            <Border x:Name="SuccessOverlay" Background="#0A0A0E" Opacity="0" IsHitTestVisible="False" CornerRadius="12">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Grid x:Name="SuccessIcon" Width="88" Height="88" Margin="0,0,0,22" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
                        <Ellipse Width="88" Height="88" Fill="#052E16" Stroke="#16A34A" StrokeThickness="2"/>
                        <Path Data="{StaticResource IconCheck}" Stroke="#4ADE80" StrokeThickness="3.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="42" Height="42" Stretch="Uniform"/>
                    </Grid>
                    <TextBlock x:Name="SuccessHeadline" Text="Spoof active" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock x:Name="SuccessDetail" Text="expires —" FontSize="13" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/>

                    <!-- Reboot warning — hammered in large so nobody misses it -->
                    <Border Margin="0,22,0,0" MaxWidth="440" Padding="18,14" CornerRadius="10"
                            Background="#2A1810" BorderBrush="#F59E0B" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="RESETS ON REBOOT" FontSize="11" FontWeight="Bold" Foreground="#FBBF24" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock FontSize="13" Foreground="#F8E8CC" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" LineHeight="20">
                                This is a <Run FontWeight="Bold" Foreground="#FDE68A">temporary</Run> spoof. It stops the moment you restart or shut down your PC.
                                <LineBreak/>
                                Run the loader and hit Spoof again every time you turn your computer back on.
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Button x:Name="ContinueBtn" Style="{StaticResource GhostBtn}" Content="Got it" Padding="30,10" Click="ContinueBtn_Click" HorizontalAlignment="Center" Margin="0,22,0,0" FontSize="13"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>

    <!-- Entrance: fade + slide + stagger metric tiles -->
    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.32"/>
                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="18" To="0" Duration="0:0:0.36">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>

                    <DoubleAnimation Storyboard.TargetName="m1" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.28" BeginTime="0:0:0.15"/>
                    <DoubleAnimation Storyboard.TargetName="m2" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.28" BeginTime="0:0:0.22"/>
                    <DoubleAnimation Storyboard.TargetName="m3" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.28" BeginTime="0:0:0.29"/>
                    <DoubleAnimation Storyboard.TargetName="m4" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.28" BeginTime="0:0:0.36"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
</Window>
