<Window x:Class="TemporarySpoofer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Temporary Spoofer" Height="620" Width="480"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="Transparent" AllowsTransparency="True"
        WindowStyle="None">

    <Border Background="{StaticResource Bg}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" Background="{StaticResource Panel}" MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource Accent}" Margin="0,0,8,0"/>
                        <TextBlock Text="Temporary Spoofer" FontSize="11" FontWeight="SemiBold" Foreground="#A0A0A8" VerticalAlignment="Center"/>
                        <TextBlock Text="v1.0" FontSize="9" Foreground="#444" VerticalAlignment="Center" Margin="8,1,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource ChromeBtn}" Content="_" Click="MinBtn_Click" FontWeight="Bold"/>
                        <Button Style="{StaticResource CloseBtn}" Content="X" Click="CloseBtn_Click" Foreground="#888" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Metrics row -->
            <Border Grid.Row="1" Margin="12,12,12,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="4" Padding="10,8" Margin="0,0,3,0">
                        <StackPanel>
                            <TextBlock Text="STATUS" FontSize="8" Foreground="#555" FontWeight="SemiBold" Margin="0,0,0,2"/>
                            <TextBlock x:Name="StatusText" Text="Idle" FontSize="11" Foreground="#6BCB77"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Background="{StaticResource Panel}" CornerRadius="4" Padding="10,8" Margin="3,0,3,0">
                        <StackPanel>
                            <TextBlock Text="PROGRESS" FontSize="8" Foreground="#555" FontWeight="SemiBold" Margin="0,0,0,2"/>
                            <TextBlock x:Name="ProgressCount" Text="0 / 0" FontSize="11" Foreground="#C8C8CC"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="{StaticResource Panel}" CornerRadius="4" Padding="10,8" Margin="3,0,3,0">
                        <StackPanel>
                            <TextBlock Text="ELAPSED" FontSize="8" Foreground="#555" FontWeight="SemiBold" Margin="0,0,0,2"/>
                            <TextBlock x:Name="ElapsedText" Text="00:00" FontSize="11" Foreground="#C8C8CC" FontFamily="{StaticResource Mono}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Background="{StaticResource Panel}" CornerRadius="4" Padding="10,8" Margin="3,0,0,0">
                        <StackPanel>
                            <TextBlock Text="EXPIRES" FontSize="8" Foreground="#555" FontWeight="SemiBold" Margin="0,0,0,2"/>
                            <TextBlock x:Name="ExpiryText" Text="—" FontSize="11" Foreground="#C8C8CC"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- License key input -->
            <Border Grid.Row="2" Margin="12,10,12,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="LICENSE KEY" FontSize="9" Foreground="#555" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox x:Name="KeyBox" Style="{StaticResource TxtBox}" FontFamily="{StaticResource Mono}" Text="TS-XXXX-XXXX-XXXX-XXXX"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Spoof button -->
            <Button Grid.Row="3" x:Name="SpoofBtn" Style="{StaticResource FlatBtn}" FontSize="14" FontWeight="SemiBold" Padding="0,14" Click="SpoofBtn_Click" Margin="12,12,12,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚡" FontSize="14" Margin="0,0,8,0" Foreground="#0A0A0A"/>
                    <TextBlock x:Name="SpoofBtnLabel" Text="Spoof now" Foreground="#0A0A0A" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>

            <!-- Current step -->
            <Border Grid.Row="4" Margin="12,8,12,0" Background="{StaticResource Panel}" CornerRadius="4" Padding="10,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Current:" FontSize="9" Foreground="#555" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="1" x:Name="CurrentStep" Text="—" FontSize="10" Foreground="#8B8B93" VerticalAlignment="Center" FontFamily="{StaticResource Mono}"/>
                </Grid>
            </Border>

            <!-- Output header -->
            <Border Grid.Row="5" Margin="12,10,12,0" Padding="0,0,0,4" BorderBrush="#222230" BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock Text="Output" FontSize="9" Foreground="#444" FontWeight="SemiBold"/>
                    <TextBlock x:Name="LogLineCount" Text="0 lines" FontSize="9" Foreground="#333" HorizontalAlignment="Right"/>
                </Grid>
            </Border>

            <!-- Log output -->
            <Border Grid.Row="6" Margin="12,6,12,0" Background="#09090B" BorderBrush="#1E1E28" BorderThickness="1" CornerRadius="4" Padding="10,8">
                <ScrollViewer x:Name="LogScroller" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="LogBox" Foreground="#6B6B73" FontSize="10" FontFamily="{StaticResource Mono}" TextWrapping="Wrap" LineHeight="16"/>
                </ScrollViewer>
            </Border>

            <!-- Progress bar -->
            <Grid Grid.Row="7" Margin="12,8,12,12">
                <Border Background="#1C1C24" Height="3" CornerRadius="2"/>
                <Border x:Name="ProgressBar" Background="{StaticResource Accent}" Height="3" HorizontalAlignment="Left" Width="0" CornerRadius="2"/>
            </Grid>

            <!-- Success overlay -->
            <Border x:Name="SuccessOverlay" Grid.RowSpan="8" Background="#0A0A0A" Opacity="0" IsHitTestVisible="False">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Width="72" Height="72" CornerRadius="36" Background="#052E16" BorderBrush="#16A34A" BorderThickness="2" Margin="0,0,0,18">
                        <TextBlock Text="✓" FontSize="40" Foreground="#4ADE80" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                    </Border>
                    <TextBlock Text="Spoof active" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <TextBlock x:Name="SuccessDetail" Text="expires —" FontSize="11" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/>
                    <Button x:Name="ContinueBtn" Style="{StaticResource GhostBtn}" Content="Continue" Padding="24,8" Click="ContinueBtn_Click" HorizontalAlignment="Center" Margin="0,22,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
