<Window x:Class="TemporarySpoofer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Temporary Spoofer" Height="640" Width="540"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="Transparent" AllowsTransparency="True"
        WindowStyle="None">

    <Border x:Name="Root" Background="{StaticResource Bg}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="10" Opacity="0">
        <Border.RenderTransform>
            <TranslateTransform Y="16"/>
        </Border.RenderTransform>
        <Grid>
            <Border CornerRadius="10" ClipToBounds="True" IsHitTestVisible="False">
                <Rectangle Fill="{StaticResource WavesBrush}"/>
            </Border>
            <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" Background="{StaticResource Panel}" MouseLeftButtonDown="TitleBar_MouseDown" CornerRadius="10,10,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource Accent}" Margin="0,0,8,0"/>
                        <TextBlock Text="Temporary Spoofer" FontSize="11" FontWeight="SemiBold" Foreground="#A0A0A8" VerticalAlignment="Center"/>
                        <TextBlock Text="v1.1" FontSize="9" Foreground="#444" VerticalAlignment="Center" Margin="8,1,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="IdBadge" FontSize="10" Foreground="#666" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource Mono}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource ChromeBtn}" Content="_" Click="MinBtn_Click" FontWeight="Bold"/>
                        <Button Style="{StaticResource CloseBtn}" Content="X" Click="CloseBtn_Click" Foreground="#888" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Metrics row -->
            <Border Grid.Row="1" Margin="14,14,14,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="6" Padding="12,9" Margin="0,0,3,0">
                        <StackPanel>
                            <TextBlock Text="STATUS" FontSize="8" Foreground="#555" FontWeight="SemiBold" Margin="0,0,0,3"/>
                            <TextBlock x:Name="StatusText" Text="Idle" FontSize="11" Foreground="#6BCB77"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Background="{StaticResource Panel}" CornerRadius="6" Padding="12,9" Margin="3,0,3,0">
                        <StackPanel>
                            <TextBlock Text="PROGRESS" FontSize="8" Foreground="#555" FontWeight="SemiBold" Margin="0,0,0,3"/>
                            <TextBlock x:Name="ProgressCount" Text="0 / 0" FontSize="11" Foreground="#C8C8CC"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="{StaticResource Panel}" CornerRadius="6" Padding="12,9" Margin="3,0,3,0">
                        <StackPanel>
                            <TextBlock Text="ELAPSED" FontSize="8" Foreground="#555" FontWeight="SemiBold" Margin="0,0,0,3"/>
                            <TextBlock x:Name="ElapsedText" Text="00:00" FontSize="11" Foreground="#C8C8CC" FontFamily="{StaticResource Mono}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Background="{StaticResource Panel}" CornerRadius="6" Padding="12,9" Margin="3,0,0,0">
                        <StackPanel>
                            <TextBlock Text="EXPIRES" FontSize="8" Foreground="#555" FontWeight="SemiBold" Margin="0,0,0,3"/>
                            <TextBlock x:Name="ExpiryText" Text="—" FontSize="11" Foreground="#C8C8CC"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Action buttons -->
            <Grid Grid.Row="2" Margin="14,12,14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" x:Name="SpoofBtn" Style="{StaticResource FlatBtn}" FontSize="13" FontWeight="SemiBold" Padding="0,15" Click="SpoofBtn_Click" Margin="0,0,4,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚡" FontSize="13" Margin="0,0,8,0" Foreground="#0A0A0A"/>
                        <TextBlock x:Name="SpoofBtnLabel" Text="Spoof now" Foreground="#0A0A0A" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="1" x:Name="CleanBtn" Style="{StaticResource GhostBtn}" FontSize="13" FontWeight="SemiBold" Padding="0,15" Click="CleanBtn_Click" Margin="4,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🧹" FontSize="13" Margin="0,0,8,0"/>
                        <TextBlock x:Name="CleanBtnLabel" Text="Clean traces" Foreground="{StaticResource Text}" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Current step -->
            <Border Grid.Row="3" Margin="14,10,14,0" Background="{StaticResource Panel}" CornerRadius="6" Padding="12,7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Current:" FontSize="9" Foreground="#555" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="1" x:Name="CurrentStep" Text="—" FontSize="10" Foreground="#8B8B93" VerticalAlignment="Center" FontFamily="{StaticResource Mono}"/>
                </Grid>
            </Border>

            <!-- Output header -->
            <Border Grid.Row="4" Margin="14,12,14,0" Padding="0,0,0,4" BorderBrush="#222230" BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock Text="Output" FontSize="9" Foreground="#444" FontWeight="SemiBold"/>
                    <TextBlock x:Name="LogLineCount" Text="0 lines" FontSize="9" Foreground="#333" HorizontalAlignment="Right"/>
                </Grid>
            </Border>

            <!-- Log output -->
            <Border Grid.Row="5" Margin="14,6,14,0" Background="#09090B" BorderBrush="#1E1E28" BorderThickness="1" CornerRadius="6" Padding="12,10">
                <ScrollViewer x:Name="LogScroller" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="LogBox" Foreground="#6B6B73" FontSize="10" FontFamily="{StaticResource Mono}" TextWrapping="Wrap" LineHeight="16"/>
                </ScrollViewer>
            </Border>

            <!-- Progress bar -->
            <Grid Grid.Row="6" Margin="14,10,14,14">
                <Border Background="#1C1C24" Height="4" CornerRadius="2"/>
                <Border x:Name="ProgressBar" Background="{StaticResource Accent}" Height="4" HorizontalAlignment="Left" Width="0" CornerRadius="2"/>
            </Grid>

            </Grid>
            <!-- Success overlay sits ABOVE the main content grid (and the waves underneath) -->
            <Border x:Name="SuccessOverlay" Background="#0A0A0A" Opacity="0" IsHitTestVisible="False" CornerRadius="10">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Width="76" Height="76" CornerRadius="38" Background="#052E16" BorderBrush="#16A34A" BorderThickness="2" Margin="0,0,0,18">
                        <TextBlock Text="✓" FontSize="42" Foreground="#4ADE80" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                    </Border>
                    <TextBlock x:Name="SuccessHeadline" Text="Spoof active" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <TextBlock x:Name="SuccessDetail" Text="expires —" FontSize="11" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/>
                    <Button x:Name="ContinueBtn" Style="{StaticResource GhostBtn}" Content="Continue" Padding="26,9" Click="ContinueBtn_Click" HorizontalAlignment="Center" Margin="0,24,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.35"/>
                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                     From="16" To="0" Duration="0:0:0.38">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
</Window>
