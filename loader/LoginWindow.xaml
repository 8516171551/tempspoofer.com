<Window x:Class="TemporarySpoofer.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Temporary Spoofer" Height="440" Width="380"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="Transparent" AllowsTransparency="True"
        WindowStyle="None">

    <Border x:Name="Root" Background="{StaticResource Bg}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="10" Opacity="0">
        <Border.RenderTransform>
            <TranslateTransform Y="14"/>
        </Border.RenderTransform>
        <Grid>
            <Border CornerRadius="10" ClipToBounds="True" IsHitTestVisible="False">
                <Rectangle Fill="{StaticResource WavesBrush}"/>
            </Border>
            <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" Background="{StaticResource Panel}" MouseLeftButtonDown="TitleBar_MouseDown" CornerRadius="10,10,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource Accent}" Margin="0,0,8,0"/>
                        <TextBlock Text="Temporary Spoofer" FontSize="11" FontWeight="SemiBold" Foreground="#A0A0A8" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource ChromeBtn}" Content="_" Click="MinBtn_Click" FontWeight="Bold"/>
                        <Button Style="{StaticResource CloseBtn}" Content="X" Click="CloseBtn_Click" Foreground="#888" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="32,10,32,28" VerticalAlignment="Center">
                <!-- Centered brand lockup -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,18">
                    <Grid Width="52" Height="52" Margin="0,0,0,12">
                        <Ellipse Width="52" Height="52" Fill="{StaticResource Accent}" Opacity="0.16"/>
                        <Ellipse Width="34" Height="34" Fill="{StaticResource Accent}" Opacity="0.3"/>
                        <Ellipse Width="14" Height="14" Fill="{StaticResource Accent}"/>
                    </Grid>
                    <TextBlock Text="Welcome back." FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Paste your license key" FontSize="11" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Compact, borderless key field -->
                <Border x:Name="KeyBorder" Background="#0E0E12" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="7" Padding="2" Margin="0,0,0,8">
                    <TextBox x:Name="KeyBox" FontFamily="{StaticResource Mono}" FontSize="13"
                             Foreground="{StaticResource Text}" Background="Transparent" BorderThickness="0"
                             Padding="12,10" Text="" CaretBrush="{StaticResource Accent}"
                             SelectionBrush="{StaticResource AccentDeep}"
                             GotFocus="KeyBox_GotFocus" LostFocus="KeyBox_LostFocus" TextChanged="KeyBox_TextChanged">
                        <TextBox.Resources>
                            <VisualBrush x:Key="PlaceholderBrush" AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                <VisualBrush.Visual>
                                    <TextBlock Text="TS-XXXX-XXXX-XXXX-XXXX" FontFamily="{StaticResource Mono}" FontSize="13" Foreground="#4B4B55"/>
                                </VisualBrush.Visual>
                            </VisualBrush>
                        </TextBox.Resources>
                    </TextBox>
                </Border>

                <TextBlock x:Name="StatusLine" Foreground="#F87171" FontSize="11" Margin="0,2,0,10" TextWrapping="Wrap" Visibility="Collapsed"/>

                <Button x:Name="LoginBtn" Style="{StaticResource FlatBtn}" Content="Continue" Click="LoginBtn_Click" Padding="0,12" FontSize="13" Margin="0,4,0,14"/>

                <TextBlock Foreground="{StaticResource Muted}" FontSize="10.5" HorizontalAlignment="Center">
                    <Run Text="One activation per key · "/>
                    <Hyperlink Click="BuyLink_Click" Foreground="{StaticResource Accent}" TextDecorations="None">Get a key</Hyperlink>
                </TextBlock>
            </StackPanel>
            </Grid>
        </Grid>
    </Border>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.32"/>
                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                     From="14" To="0" Duration="0:0:0.36">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
</Window>
