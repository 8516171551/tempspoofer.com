<Window x:Class="TemporarySpoofer.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Temporary Spoofer" Height="460" Width="380"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="Transparent" AllowsTransparency="True"
        WindowStyle="None">

    <Border Background="{StaticResource Bg}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" Background="{StaticResource Panel}" MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource Accent}" Margin="0,0,8,0"/>
                        <TextBlock Text="Temporary Spoofer" FontSize="11" FontWeight="SemiBold" Foreground="#A0A0A8" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource ChromeBtn}" Content="_" Click="MinBtn_Click" FontWeight="Bold"/>
                        <Button Style="{StaticResource CloseBtn}" Content="X" Click="CloseBtn_Click" Foreground="#888" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="32,18,32,20" VerticalAlignment="Center">
                <TextBlock Text="Welcome back." FontSize="22" FontWeight="Bold" Margin="0,0,0,4"/>
                <TextBlock Text="Log in to redeem your passes." FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,24"/>

                <TextBlock Text="EMAIL" FontSize="9" Foreground="#666" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="EmailBox" Style="{StaticResource TxtBox}" Margin="0,0,0,14"/>

                <TextBlock Text="PASSWORD" FontSize="9" Foreground="#666" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <PasswordBox x:Name="PasswordBox" Style="{StaticResource PwdBox}" Margin="0,0,0,10"/>

                <TextBlock x:Name="ErrorText" Foreground="#F87171" FontSize="11" Margin="0,0,0,10" Visibility="Collapsed"/>

                <Button x:Name="LoginBtn" Style="{StaticResource FlatBtn}" Content="Log in" Click="LoginBtn_Click" Margin="0,4,0,10"/>

                <TextBlock Foreground="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Center">
                    <Run Text="No account? "/>
                    <Hyperlink x:Name="RegisterLink" Click="RegisterLink_Click" Foreground="{StaticResource Accent}" TextDecorations="None">Register at tempspoofer.com</Hyperlink>
                </TextBlock>
            </StackPanel>
        </Grid>
    </Border>
</Window>
