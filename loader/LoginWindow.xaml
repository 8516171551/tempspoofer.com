<Window x:Class="TemporarySpoofer.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Temporary Spoofer" Height="460" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="Transparent" AllowsTransparency="True"
        WindowStyle="None">

    <Window.Resources>
        <VisualBrush x:Key="PlaceholderBrush" AlignmentX="Left" AlignmentY="Center" Stretch="None">
            <VisualBrush.Visual>
                <TextBlock Text="TS-XXXX-XXXX-XXXX-XXXX" FontFamily="{StaticResource Mono}" FontSize="14" Foreground="#4B4B55"/>
            </VisualBrush.Visual>
        </VisualBrush>
    </Window.Resources>

    <Border x:Name="Root" Background="{StaticResource Bg}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="12" Opacity="0">
        <Border.RenderTransform><TranslateTransform Y="14"/></Border.RenderTransform>
        <Grid>
            <!-- Grid texture -->
            <Border CornerRadius="12" ClipToBounds="True" IsHitTestVisible="False">
                <Rectangle Fill="{StaticResource GridBrush}"/>
            </Border>
            <!-- Centered glow behind the brand lockup -->
            <Border CornerRadius="12" ClipToBounds="True" IsHitTestVisible="False">
                <Ellipse Width="300" Height="300" Fill="{StaticResource GlowBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-40,0,0" Opacity="0.9">
                    <Ellipse.RenderTransform><ScaleTransform x:Name="glowS" ScaleX="1" ScaleY="1" CenterX="150" CenterY="150"/></Ellipse.RenderTransform>
                    <Ellipse.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="glowS" Storyboard.TargetProperty="ScaleX" From="0.95" To="1.1" Duration="0:0:6" AutoReverse="True" RepeatBehavior="Forever"/>
                                    <DoubleAnimation Storyboard.TargetName="glowS" Storyboard.TargetProperty="ScaleY" From="0.95" To="1.1" Duration="0:0:6" AutoReverse="True" RepeatBehavior="Forever"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Ellipse.Triggers>
                </Ellipse>
                </Border>

            <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource Panel}" MouseLeftButtonDown="TitleBar_MouseDown" CornerRadius="12,12,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <TextBlock x:Name="BrandLabel" Text="Temporary Spoofer" FontSize="11" FontWeight="SemiBold" Foreground="#A0A0A8" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource ChromeBtn}" Click="MinBtn_Click">
                            <Path Data="{StaticResource IconMin}" Stroke="#AAA" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="14" Height="14" Stretch="Uniform"/>
                        </Button>
                        <Button Style="{StaticResource CloseBtn}" Click="CloseBtn_Click">
                            <Path Data="{StaticResource IconClose}" Stroke="#AAA" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="Uniform"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="36,8,36,32" VerticalAlignment="Center">
                <!-- brand lockup with subtle inner rotation on the rings -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,22">
                    <Grid Width="68" Height="68" Margin="0,0,0,14">
                        <Ellipse Width="68" Height="68" Fill="{StaticResource Accent}" Opacity="0.14"/>
                        <Ellipse Width="44" Height="44" Fill="{StaticResource Accent}" Opacity="0.28"/>
                        <Ellipse Width="18" Height="18" Fill="{StaticResource Accent}"/>
                    </Grid>
                    <TextBlock Text="Welcome back." FontSize="21" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Paste your license key" FontSize="13" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>

                <!-- Key field with animated focus ring -->
                <Border x:Name="KeyBorder" Background="#0E0E14" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Padding="2" Margin="0,0,0,10">
                    <TextBox x:Name="KeyBox" FontFamily="{StaticResource Mono}" FontSize="14"
                             Foreground="{StaticResource Text}" Background="Transparent" BorderThickness="0"
                             Padding="14,11" Text="" CaretBrush="{StaticResource Accent}"
                             SelectionBrush="{StaticResource AccentDeep}"
                             GotFocus="KeyBox_GotFocus" LostFocus="KeyBox_LostFocus" TextChanged="KeyBox_TextChanged"/>
                </Border>

                <TextBlock x:Name="StatusLine" Foreground="#F87171" FontSize="12" Margin="0,2,0,12" TextWrapping="Wrap" Visibility="Collapsed"/>

                <Button x:Name="LoginBtn" Style="{StaticResource FlatBtn}" Content="Continue" Click="LoginBtn_Click" Padding="0,14" FontSize="14" Margin="0,4,0,16"/>

                <TextBlock Foreground="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Center">
                    <Run Text="One activation per key · "/>
                    <Hyperlink Click="BuyLink_Click" Foreground="{StaticResource Accent}" TextDecorations="None">Get a key</Hyperlink>
                </TextBlock>
            </StackPanel>
            </Grid>
        </Grid>
    </Border>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.32"/>
                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="14" To="0" Duration="0:0:0.36">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
</Window>
