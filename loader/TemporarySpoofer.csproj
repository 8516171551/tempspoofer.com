<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>TemporarySpoofer</RootNamespace>
    <AssemblyName>loader</AssemblyName>
    <StartupObject>TemporarySpoofer.App</StartupObject>
    <!-- No AppHost stub: build produces a managed PE that Reflection.Assembly.Load
         can pull straight into memory with no disk touch. -->
    <UseAppHost>false</UseAppHost>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <DebugType>embedded</DebugType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Debug builds skip the anti-debug / anti-tamper fence so we can
         actually attach a debugger. Release builds enforce it. -->
    <DefineConstants Condition="'$(Configuration)' == 'Debug'">$(DefineConstants);TS_DEV</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.ServiceProcess" />
    <Reference Include="System.Net.Http" />
    <!-- DPAPI for per-user InstallIdentity encryption. -->
    <Reference Include="System.Security" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Fonts\*.ttf" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="AssemblyInfo.cs" />
  </ItemGroup>

</Project>
